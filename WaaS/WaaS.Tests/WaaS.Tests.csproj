<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <!-- NativeEditorLibraryTests calls the native library through function pointers -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="NUnit" Version="5.0.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0"/>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WaaS.Core\WaaS.Core.csproj"/>
        <ProjectReference Include="..\WaaS.Generators\WaaS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
