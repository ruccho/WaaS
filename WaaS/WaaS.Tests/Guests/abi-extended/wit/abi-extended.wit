package waas:abi-extended;

// values passed in both directions:
// the guest imports `values` from the host and also exports it
interface values {
    record inner {
        a: u8,
        b: option<s16>,
        c: list<string>,
    }

    variant tree {
        leaf(s8),
        node(inner),
        pair(tuple<u16, f64>),
        text(string),
        empty,
    }

    record outer {
        name: string,
        inner: inner,
        items: list<inner>,
        tree: tree,
        maybe: option<result<u32, string>>,
        nested: list<list<s64>>,
    }

    enum level {
        low,
        mid,
        high,
    }

    // stored in u8
    flags small-flags {
        f0, f1, f2,
    }

    // stored in u16
    flags medium-flags {
        f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11,
    }

    // stored in u32
    flags large-flags {
        f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15,
        f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31,
    }

    integers: func(a: u8, b: s8, c: u16, d: s16, e: u32, f: s32, g: u64, h: s64, i: bool)
        -> tuple<u8, s8, u16, s16, u32, s32, u64, s64, bool>;
    small-integers: func(a: s8, b: s16, c: u8, d: u16) -> tuple<s8, s16, u8, u16>;
    floats: func(a: f32, b: f64) -> tuple<f32, f64>;
    chars: func(value: char) -> char;
    text: func(value: string) -> string;
    texts: func(values: list<string>) -> list<string>;
    bytes: func(values: list<u8>) -> list<u8>;
    shorts: func(values: list<s16>) -> list<s16>;
    outer-value: func(value: outer) -> outer;
    trees: func(values: list<tree>) -> list<tree>;
    flags-value: func(a: small-flags, b: medium-flags, c: large-flags)
        -> tuple<small-flags, medium-flags, large-flags>;
    levels: func(values: list<level>) -> list<level>;
    options: func(a: option<u8>, b: option<string>, c: option<option<s32>>)
        -> tuple<option<u8>, option<string>, option<option<s32>>>;
    results: func(a: result<s8, u64>, b: result<_, string>, c: result<string>, d: result)
        -> tuple<result<s8, u64>, result<_, string>, result<string>, result>;
    // more than 16 flattened parameters are passed through the memory
    many-params: func(p0: s32, p1: s64, p2: f32, p3: f64, p4: u8, p5: s8, p6: u16, p7: s16, p8: string,
        p9: s32, p10: s32, p11: s32, p12: s32, p13: s32, p14: s32, p15: s32, p16: s32, p17: f64) -> string;
    // a tuple of more than 7 elements, with an alignment gap after the 7th element
    long-tuple: func(value: tuple<s32, s32, s32, s32, s32, s32, s32, u8, s64, string>)
        -> tuple<s32, s32, s32, s32, s32, s32, s32, u8, s64, string>;
}

// resources of the host in records and lists
interface resources {
    resource blob {
        value: func() -> s32;
    }

    record holder {
        name: string,
        blob: blob,
        extra: option<blob>,
    }

    record borrowing {
        blob: borrow<blob>,
        factor: s32,
    }

    make-blob: func(value: s32) -> blob;
    make-blobs: func(values: list<s32>) -> list<blob>;
    // takes the ownership of the blobs
    take-blobs: func(blobs: list<blob>) -> s32;
    sum-borrowed: func(blobs: list<borrow<blob>>) -> s32;
    swap-holder: func(value: holder) -> holder;
    multiply: func(value: borrowing) -> s32;
}

world abi-extended {
    use resources.{blob};

    import values;
    import resources;
    export values;

    // the description (Debug of Rust) of the arguments of the last call of an export of `values`
    export last-call: func() -> string;
    // calls the imports of `values` and returns the mismatches
    export test-values: func() -> list<string>;
    // calls the imports of `resources` and returns the description
    export test-resources: func() -> string;
    export sum-owned: func(blobs: list<blob>) -> s32;
    // list<borrow<blob>> in the parameters of exports is not tested,
    // because the code generated by wit-bindgen 0.63 for it does not compile
}
