package waas:abi-test;

interface host {
    resource counter {
        get: func() -> s32;
        increment: func();
    }

    record point {
        x: s32,
        y-coord: f32,
    }

    variant shape {
        circle(f32),
        rect(point),
        empty,
    }

    enum color {
        red,
        green-blue,
    }

    flags permissions {
        read,
        write,
    }

    make-counter: func(initial: s32) -> counter;
    read-counter: func(counter: borrow<counter>) -> s32;
    echo: func(value: string) -> string;
    sum: func(values: list<s32>) -> s64;
    increment-optional: func(value: option<s32>) -> option<s32>;
    checked-negate: func(value: s32) -> result<s32, string>;
    shape-area: func(shape: shape) -> f32;
    describe: func(color: color, permissions: permissions) -> string;
    // completes asynchronously on the host
    wait-ticks: func(ticks: u32) -> u32;
}

// resources defined by the guest
interface guest-types {
    resource accumulator {
        constructor(start: s32);
        add: func(value: s32);
        total: func() -> s32;
    }

    // number of accumulators destroyed so far
    destroyed-count: func() -> u32;
    // takes the ownership of an accumulator back and returns its total
    consume: func(accumulator: accumulator) -> s32;
}

world abi-test {
    use host.{counter, point};

    import host;
    export guest-types;

    export test-resource: func() -> s32;
    export test-borrow-param: func(counter: borrow<counter>) -> s32;
    export test-string: func(value: string) -> string;
    export test-list: func() -> s64;
    export test-option: func() -> s32;
    export test-result: func() -> string;
    export test-record: func(value: point) -> point;
    export test-variant: func() -> f32;
    export test-enum-flags: func() -> string;
    export test-async: func() -> u32;
    // uses a handle that was never passed to the component
    export test-forged-handle: func(handle: u32) -> s32;
}
