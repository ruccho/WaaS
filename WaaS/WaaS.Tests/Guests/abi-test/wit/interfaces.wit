package waas:abi-test;

interface host {
    resource counter {
        get: func() -> s32;
        increment: func();
    }

    record point {
        x: s32,
        y-coord: f32,
    }

    variant shape {
        circle(f32),
        rect(point),
        empty,
    }

    enum color {
        red,
        green-blue,
    }

    flags permissions {
        read,
        write,
    }

    make-counter: func(initial: s32) -> counter;
    read-counter: func(counter: borrow<counter>) -> s32;
    echo: func(value: string) -> string;
    sum: func(values: list<s32>) -> s64;
    increment-optional: func(value: option<s32>) -> option<s32>;
    checked-negate: func(value: s32) -> result<s32, string>;
    shape-area: func(shape: shape) -> f32;
    describe: func(color: color, permissions: permissions) -> string;
    // completes asynchronously on the host
    wait-ticks: func(ticks: u32) -> u32;
}

// resources defined by the guest
interface guest-types {
    resource accumulator {
        constructor(start: s32);
        add: func(value: s32);
        total: func() -> s32;
    }

    // number of accumulators destroyed so far
    destroyed-count: func() -> u32;
    // takes the ownership of an accumulator back and returns its total
    consume: func(accumulator: accumulator) -> s32;
}
