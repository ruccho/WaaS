// The functions of the world in the file generated by wit-bindgen. Keep the behavior identical to guest/src/lib.rs.

///|
pub fn compute_fib(n : UInt) -> Double {
  @workloads.compute_fib(n)
}

///|
pub fn compute_sieve(n : UInt) -> Double {
  @workloads.compute_sieve(n)
}

///|
pub fn compute_mandelbrot(n : UInt) -> Double {
  @workloads.compute_mandelbrot(n)
}

///|
pub fn compute_strings(n : UInt) -> Double {
  @workloads.compute_strings(n)
}

///|
pub fn compute_sort(n : UInt) -> Double {
  @workloads.compute_sort(n)
}

///|
pub fn compute_map(n : UInt) -> Double {
  @workloads.compute_map(n)
}

///|
pub fn ffi_nop(n : UInt) -> Double {
  for _ in 0..<n.reinterpret_as_int() {
    @host.nop()
  }
  n.to_double()
}

///|
pub fn ffi_add(n : UInt) -> Double {
  let mut value = 0
  for _ in 0..<n.reinterpret_as_int() {
    value = @host.add(value, 1)
  }
  value.to_double()
}

///|
pub fn ffi_string_in(n : UInt) -> Double {
  let mut total : UInt64 = 0
  for _ in 0..<n.reinterpret_as_int() {
    total += @host.take_string("hello, world").to_uint64()
  }
  total.to_double()
}

///|
pub fn ffi_string_out(n : UInt) -> Double {
  let mut total : UInt64 = 0
  for _ in 0..<n.reinterpret_as_int() {
    total += @host.get_string().length().to_uint64()
  }
  total.to_double()
}

///|
pub fn ffi_struct(n : UInt) -> Double {
  let mut value : @host.Vec3 = { x: 0.0, y: 0.0, z: 0.0 }
  for _ in 0..<n.reinterpret_as_int() {
    value = @host.transform(value)
  }
  (value.x + value.y + value.z).to_double()
}

///|
pub fn ffi_resource(n : UInt) -> Double {
  let counter = @host.get_counter()
  let mut value = 0
  for _ in 0..<n.reinterpret_as_int() {
    value = counter.add(1)
  }
  counter.drop()
  value.to_double()
}

///|
pub fn callback_add(a : Int, b : Int) -> Int {
  a + b
}

///|
pub fn callback_string(value : String) -> Int {
  value.length()
}
